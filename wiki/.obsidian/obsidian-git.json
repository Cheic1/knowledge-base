{
  "autoSaveInterval": 5,
  "autoPullInterval": 5,
  "autoPushInterval": 5,
  "autoPullOnBoot": true,
  "autoPushOnBoot": true,
  "disablePush": false,
  "pullBeforePush": true,
  "disablePopups": false,
  "listChangedFilesInMessageBody": true,
  "commitMessage": "Auto-commit: {{date}}",
