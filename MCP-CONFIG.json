{
  "_note": "Configurazione MCP di riferimento. Lo script scripts/connect-agent.sh genera queste entry nei file reali di ogni agente, sostituendo l'endpoint da config/endpoint.env. Formato OpenCode: chiave 'mcp' + campo 'environment'. Formato standard (Cursor/VS Code/Hermes): 'mcpServers' + campo 'env'.",
  "_endpoint": "vedi config/endpoint.env (KB_API_URL)",
  "opencode": {
    "mcp": {
      "agentmemory": {
        "type": "local",
        "command": ["npx", "-y", "@agentmemory/mcp"],
        "environment": {
          "AGENTMEMORY_URL": "http://192.168.68.55:8311"
        },
        "enabled": true,
        "timeout": 10000
      },
      "llm-wiki": {
        "type": "local",
        "command": ["node", "<REPO>/mcp/llm-wiki-mcp/dist/src/index.js"],
        "environment": {
          "LLM_WIKI_API_BASE_URL": "http://192.168.68.55:8318"
        },
        "enabled": true,
        "timeout": 10000
      }
    }
  },
  "cursor": {
