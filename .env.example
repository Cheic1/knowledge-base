# ============================================
# My Knowledge Base - Environment Variables
# ============================================

# --------------------------------------------
# LLM Provider (scegli uno)
# --------------------------------------------
# OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gemini
# GEMINI_API_KEY=your-key-here

# Ollama (locale, gratuito)
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b

# --------------------------------------------
# Embedding Provider (opzionale)
# --------------------------------------------
# Locale (gratuito, after first download)
# EMBEDDING_PROVIDER=local

# OpenAI
# EMBEDDING_PROVIDER=openai

# --------------------------------------------
# agentmemory
# --------------------------------------------
# AGENTMEMORY_DATA_DIR=/DATA/AppData/my-knowledge-base/.agentmemory
# AGENTMEMORY_AUTO_COMPRESS=true
# GRAPH_EXTRACTION_ENABLED=true
# CONSOLIDATION_ENABLED=true

# --------------------------------------------
# LLM Wiki
# --------------------------------------------
# LLM_WIKI_PORT=19828
# LLM_WIKI_PROJECT_DIR=/DATA/AppData/my-knowledge-base/wiki

# --------------------------------------------
# Aggiornamento automatico (scripts/kb.mjs)
# --------------------------------------------
# Ogni quante ore kb.mjs update controlla main (default 24)
# KB_UPDATE_HOURS=24
# Server: ora della finestra di manutenzione notturna (riavvii in sospeso), HH:MM
# KB_MAINTENANCE_AT=03:00

# --------------------------------------------
# Git
# --------------------------------------------
# GIT_REMOTE=git@github.com:Cheic1/knowledge-base.git
# GIT_BRANCH=main

# --------------------------------------------
# Sicurezza
# --------------------------------------------
# Token condiviso del kb-proxy (genera con: node scripts/kb.mjs token).
# Sui PC client copia qui lo stesso valore del server.
# KB_TOKEN=
# KB_AUTH=off   # disattiva l'auth del proxy (sconsigliato)
# AGENTMEMORY_SECRET=your-secret-here
# API_TOKEN=your-api-token-here

# --------------------------------------------
# Multilingua
# --------------------------------------------
# LANGUAGE=it
# EMBEDDING_LANG=it